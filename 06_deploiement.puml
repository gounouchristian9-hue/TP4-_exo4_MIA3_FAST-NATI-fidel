@startuml
title Diagramme de déploiement
node "Poste Scolarité" as P1 {
  artifact "gestion_departement.exe" as A1
}
node "Poste Enseignant" as P2 {
  artifact "gestion_departement.exe" as A2
}
node "Poste Direction / Jury" as P3 {
  artifact "gestion_departement.exe" as A3
}
node "Serveur de fichiers du département" as S {
  folder "data/" {
    artifact "etudiants.csv"
    artifact "enseignants.csv"
    artifact "filieres.csv / niveaux.csv"
    artifact "ues.csv / matieres.csv"
    artifact "salles.csv / seances.csv"
    artifact "notes.csv"
  }
  folder "releves/" {
    artifact "releve_<id>.txt"
  }
}

P1 --> S : <<partage réseau>>\nlecture / écriture
P2 --> S : <<partage réseau>>
P3 --> S : <<partage réseau>>
note bottom of S
  Persistance initiale par fichiers.
  Évolution possible vers un SGBD (SQLite / PostgreSQL)
  en remplaçant uniquement le dépôt CSV.
end note
@enduml
